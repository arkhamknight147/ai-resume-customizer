# Copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed to version control.

# Required — your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — enable HTTP Basic Auth when deploying to a shared/public URL.
# Leave blank (or remove) to disable authentication in local development.
AUTH_USER=your-username-here
AUTH_PASS=your-password-here
